# LLM Provider / Router Configuration
# Supported providers: litellm, azure
LLM_PROVIDER=litellm
LLM_DEFAULT_MODEL=GPT-5.4

# Optional per-service model/deployment overrides.
# Leave blank to use LLM_DEFAULT_MODEL.
LLM_QUERY_MODEL=
LLM_CHAT_MODEL=
LLM_INSIGHTS_MODEL=
LLM_SYSTEMATIC_REVIEW_MODEL=
LLM_EXTRACTION_MODEL=
LLM_METADATA_MODEL=

# Compatibility toggles: auto, true, false
LLM_USE_RESPONSE_FORMAT=auto
LLM_USE_TEMPERATURE=auto
LLM_USE_SEED=false
LLM_REQUEST_TIMEOUT=180
LLM_EXTRACTION_CONCURRENCY=3

# LiteLLM Configuration
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_BASE_URL=your_litellm_base_url_here

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=GPT-5.4

# NCBI API Configuration
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_API_EMAIL=your_ncbi_email_here
NCBI_TOOL_NAME="clinical-trials-hub"

NCBI_API_KEY2=your_ncbi_api_key2_here
NCBI_API_EMAIL2=your_ncbi_email2_here

NCBI_API_KEY3=your_ncbi_api_key3_here
NCBI_API_EMAIL3=your_ncbi_email3_here

# Database Configuration
DB_USER=your_postgres_user_here
DB_PASS=your_postgres_password_here
DB_HOST=host.docker.internal # Use 127.0.0.1 if running without Docker
DB_PORT=5432
DB_NAME=trials

# Server Configuration
PORT=5050

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://redis:6379

# Pagination Configuration
MAX_FETCH_SIZE=1000
DEFAULT_PAGE_SIZE=10
